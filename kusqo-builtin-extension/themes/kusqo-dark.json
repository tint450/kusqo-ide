  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5b5b7a", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "keyword.control"], "settings": { "foreground": "#c084fc" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#818cf8" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#67e8f9" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#fcd34d" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character.escape"], "settings": { "foreground": "#f472b6" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#e4e4e7" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#c7d2fe" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#818cf8" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c084fc" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#a5b4fc" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#a1a1aa" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#c084fc", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#fcd34d" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f87171" } }
  ]
}
