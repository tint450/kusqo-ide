{
  "name": "kusqo-ide",
  "displayName": "KUSQO IDE",
  "description": "KUSQO IDE - chat, plans, verified builds and local execution connected to your KUSQO account",
  "version": "0.10.0",
  "publisher": "kusqo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kusqo.login",
        "title": "KUSQO: Sign in"
      },
      {
        "command": "kusqo.chat",
        "title": "KUSQO: Open Agent Chat"
      },
      {
        "command": "kusqo.logout",
        "title": "KUSQO: Sign out"
      },
      {
        "command": "kusqo.preview",
        "title": "KUSQO: Open Preview"
      },
      {
        "command": "kusqo.fixVerify",
        "title": "KUSQO: Fix & Verify (local run)"
      },
      {
        "command": "kusqo.agent",
        "title": "KUSQO: Agent (plan & execute locally)"
      },
      {
        "command": "kusqo.memoryRules",
        "title": "KUSQO: Generate project memory rules (.kusqorules)"
      },
      {
        "command": "kusqo.inlineEdit",
        "title": "KUSQO: Inline Edit (Ctrl+K)"
      },
      {
        "command": "kusqo.fixVerifyHeal",
        "title": "KUSQO: Fix & Verify (self-healing)"
      },
      {
        "command": "kusqo.verify",
        "title": "KUSQO: Verify project (proof report)"
      },
      {
        "command": "kusqo.proof",
        "title": "KUSQO: Open last proof report"
      },
      {
        "command": "kusqo.newChat",
        "title": "KUSQO: New chat",
        "icon": "$(add)"
      },
      {
        "command": "kusqo.studySite",
        "title": "KUSQO: Study a website"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "kusqo.fixVerify",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "kusqo.newChat",
          "when": "view == kusqo.agentView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kusqo",
          "title": "KUSQO",
          "icon": "media/kusqo.svg"
        }
      ]
    },
    "views": {
      "kusqo": [
        {
          "type": "webview",
          "id": "kusqo.agentView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "KUSQO",
      "properties": {
        "kusqo.apiUrl": {
          "type": "string",
          "default": "https://api.kusqo.com",
          "description": "KUSQO API base URL"
        },
        "kusqo.tenantSlug": {
          "type": "string",
          "default": "",
          "description": "Workspace slug (empty = personal)"
        },
        "kusqo.autoVerify": {
          "type": "boolean",
          "default": true,
          "description": "Run kusqo-verify automatically after applying generated changes."
        },
        "kusqo.livePreview": {
          "type": "boolean",
          "default": true,
          "description": "Open the live preview automatically when a generated website lands in the workspace, and refresh it as files change."
        },
        "kusqo.autoContext": {
          "type": "boolean",
          "default": true,
          "description": "In Ask mode, automatically add the most relevant workspace files (local lexical search) as context. Use @path or @codebase to control it explicitly."
        },
        "kusqo.experience": {
          "type": "string",
          "enum": [
            "beginner",
            "developer"
          ],
          "default": "beginner",
          "description": "Beginner: plain-language answers and a plan to approve before anything is built. Developer: concise answers, direct builds."
        }
      }
    },
    "keybindings": [
      {
        "command": "kusqo.inlineEdit",
        "key": "ctrl+k",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kusqo.fixVerifyHeal",
        "key": "ctrl+alt+v",
        "when": ""
      }
    ],
    "themes": [
      {
        "label": "KUSQO Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/kusqo-dark.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "kusqo.welcome",
        "title": "Get started with KUSQO",
        "description": "Ask, plan, build and verify - with every change under your control.",
        "steps": [
          {
            "id": "signin",
            "title": "Sign in",
            "description": "Connect your KUSQO account.\n[Sign in](command:kusqo.login)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            }
          },
          {
            "id": "chat",
            "title": "Ask first, build when ready",
            "description": "Open the KUSQO chat.\n[Open chat](command:kusqo.chat)",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            }
          },
          {
            "id": "attach",
            "title": "Attach what you have",
            "description": "Photos, screenshots and data files are analysed before anything is built.",
            "media": {
              "markdown": "media/walkthrough/attach.md"
            }
          },
          {
            "id": "verify",
            "title": "Build verified",
            "description": "Prove it works, revert in one click.\n[Verify project](command:kusqo.verify)",
            "media": {
              "markdown": "media/walkthrough/verify.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "vsce": "^2.15.0"
  },
  "icon": "media/icon.png"
}
